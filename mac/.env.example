# ============================================================
# 配置文件：把本文件复制为 .env，然后填入你自己的火山引擎凭据
#   cp .env.example .env
# 凭据获取：https://console.volcengine.com/ark （开通后有免费额度）
# 注意：.env 含密钥，不要提交到 git（.gitignore 已默认排除）
# ============================================================

# ---------- 必填 ----------

# 火山引擎 API Key（ARK = 方舟平台，控制台"API Key 管理"里创建）
ARK_API_KEY=在这里填你的API-Key

# 模型接入点 ID（控制台"在线推理"里创建接入点后获得，形如 ep-xxxx 或自定义推理点 ID）
ARK_MODEL_ID=在这里填你的模型ID


# ---------- 可选（不填走默认值，默认值见 config/config.go）----------

# 有多张作业卡时，按标题关键词选卡（默认：刷题）
# ASSIGN_KEYWORD=刷题

# Chrome 可执行文件路径（默认自动探测，探测顺序见 config/env.go）
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# 浏览器 profile 目录，登录态持久化于此（默认：.chrome-profile）
# CHROME_USER_DATA=.chrome-profile

# CDP 调试端口（默认：9223）
# CDP_PORT=9223

# 直接接入一个已经开着的浏览器，跳过自动登录（默认空，即正常走登录流程）
# CDP_URL=http://127.0.0.1:9223

# 跑验证码识别用的 Python 解释器（默认自动探测）
# PYTHON_BIN=/usr/bin/python3

# 【v1.2.0 新增】得分低于等于此值即重答该题；设为 -1 表示从不重答（默认：0，即只有一分未得才重答）
# REANSWER_THRESHOLD=0

# 【v1.2.0 新增】单题最多作答次数，含首次（默认：2；设为 1 等价于"不重答"）
# MAX_ANSWER_TRY=2

# 【v1.2.0 新增】Prompt 覆盖文件路径，只写想改的 key 即可，其余保持内置默认
#   生成模板：go run . -prompts-init  →  prompts.example.json
# PROMPTS_FILE=prompts.json

# 【v1.2.0 新增】日志格式：text（默认，人看）/ json（结构化，方便 grep 或投喂给程序）
# LOG_FORMAT=text
